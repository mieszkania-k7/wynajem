<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Harmonogram macOS: wyszukiwanie o 8:05, 15:05 i 20:05.
     Gdy Mac śpi o tej godzinie, wyszukiwanie uruchomi się zaraz po wybudzeniu. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>pl.kinga.wynajem</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__KATALOG__/uruchom.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>5</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__KATALOG__/cache/launchd.log</string>
  <key>StandardErrorPath</key><string>__KATALOG__/cache/launchd.log</string>
</dict>
</plist>
